OPENAI_API_KEY=
aliyun_API_KEY=
volcano_API_KEY=
deepseek_API_KEY=
# 填写服务器或容器可访问的模型服务地址，以 /v1 结尾。
QWEN35_4B_DOCKER_BASE_URL=
QWEN35_9B_DOCKER_BASE_URL=
QWEN35_9B_MIX64_DOCKER_BASE_URL=

# 可选：使用单独的 NL2Verus 私有模型配置，否则复用平台模型配置
NL2VERUS_CONFIG=
# 可选：指定固定版本 Verus 可执行文件，否则使用 tools/verus 下本机版本
VERUS_EXECUTABLE=

# 共享 C 验证器：auto 优先本机 Frama-C，其次专用验证容器。
# AutoSpec 镜像只服务 legacy AutoSpec 完整流水线，不参与共享验证。
ACSL_VERIFIER_RUNTIME=auto
ACSL_VERIFIER_SERVICE=verifier
# spectool 验证单独覆盖：auto | host | container
SPECTOOL_VERIFY_RUNNER=auto
# 可选：指定本机 Frama-C 可执行文件；留空使用 PATH
SPECTOOL_FRAMAC=

# Agent runtimes: optional server-accessible proxy, executable overrides, DeepSeek model and worker limit.
# Leave proxy empty for direct connections.
XUANJIAN_AGENT_PROXY=
XUANJIAN_CODEX_EXECUTABLE=
XUANJIAN_CLAUDE_EXECUTABLE=
DEEPSEEK_HARNESS_MODEL=
ACSL_AGENT_MAX_WORKERS=2

# 同源部署无需配置跨域；前后端分开部署时填写前端域名，多个用逗号分隔。
ACSL_AGENT_ALLOWED_ORIGINS=
# API 直接运行时使用的模型服务地址；Docker 使用上方对应的 DOCKER_BASE_URL。
QWEN35_4B_API_BASE_URL=
QWEN35_9B_API_BASE_URL=
QWEN35_9B_MIX64_API_BASE_URL=
QWEN35_4B_MIX46_API_BASE_URL=
QWEN35_4B_MIX46_DOCKER_BASE_URL=
QWEN35_4B_MIX64_API_BASE_URL=
QWEN35_4B_MIX64_DOCKER_BASE_URL=
QWEN35_9B_MIX28_API_BASE_URL=
QWEN35_9B_MIX28_DOCKER_BASE_URL=
QWEN35_9B_MIX46_API_BASE_URL=
QWEN35_9B_MIX46_DOCKER_BASE_URL=
QWEN35_9B_MIX82_API_BASE_URL=
QWEN35_9B_MIX82_DOCKER_BASE_URL=
QWEN35_9B_ONLY1_API_BASE_URL=
QWEN35_9B_ONLY1_DOCKER_BASE_URL=
QWEN35_9B_ONLY2_API_BASE_URL=
QWEN35_9B_ONLY2_DOCKER_BASE_URL=

# Rust Agent deployment: CLI dependencies are built into the image separately
# from runtime/ data. For local installs leave this empty (uses ./runtime).
ACSL_AGENT_RUNTIME_ROOT=
# One server-reachable model service; no workstation-specific URL is committed.
NL2VERUS_MODEL_BASE_URL=
NL2VERUS_MODEL_ID=deepseek-v4-flash-0731
NL2VERUS_MODEL_NAME=deepseek-v4-flash
NL2VERUS_MODEL_API_KEY=
NL2VERUS_MODEL_AUTH_MODE=none
# Enable only protocols actually supported by the server. Claude Code requires anthropic.
NL2VERUS_MODEL_PROTOCOLS=chat,responses,anthropic

# The pinned Verus release has a Linux x86_64 build; use this image platform.
ACSL_AGENT_IMAGE_PLATFORM=linux/amd64
ACSL_AGENT_INSTALL_VERUS=1
# Upper Agent model endpoint (OpenAI-compatible /v1); set on the deployment host.
DEEPSEEK_ORCHESTRATOR_BASE_URL=

# Private credential for authenticated mix64 inference services.
QWEN_MIX64_API_KEY=

# Optional task-scoped SSH route for private Qwen mix64 endpoints.
XUANJIAN_QWEN_SSH_TARGET=
XUANJIAN_QWEN_SSH_PORT=22
