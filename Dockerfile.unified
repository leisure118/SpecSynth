ARG BASE_IMAGE=python:3.13-slim
ARG NODE_IMAGE=node:24-bookworm-slim
FROM ${NODE_IMAGE} AS agent-node

# Build the platform-native official CLIs independently from mutable user data.
FROM agent-node AS agent-runtime
ARG NPM_REGISTRY=
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY configs/agent-runtime/ /tmp/agent-install/configs/agent-runtime/
COPY configs/deepseek-runtime/ /tmp/agent-install/configs/deepseek-runtime/
COPY scripts/install_agent_runtime.py /tmp/agent-install/scripts/install_agent_runtime.py
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
    && python3 /tmp/agent-install/scripts/install_agent_runtime.py --runtime-root /opt/acsl-agent/agents \
    && rm -rf /root/.npm /tmp/agent-install

FROM ${BASE_IMAGE}

ARG APT_MIRROR=
ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
ARG NPM_REGISTRY=
ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY}

RUN if [ -n "$APT_MIRROR" ]; then \
        if [ -f /etc/apt/sources.list ]; then \
            sed -i "s|http://deb.debian.org/debian|$APT_MIRROR|g" /etc/apt/sources.list; \
            sed -i "s|http://security.debian.org/debian-security|$APT_MIRROR-security|g" /etc/apt/sources.list || true; \
        fi; \
        if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
            sed -i "s|http://deb.debian.org/debian|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
            sed -i "s|http://security.debian.org/debian-security|$APT_MIRROR-security|g" /etc/apt/sources.list.d/debian.sources || true; \
        fi; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        gcc \
        g++ \
        make \
        git \
        ripgrep \
        z3 \
        libgmp10 libgomp1 libstdc++6 \
        bubblewrap \
        ca-certificates \
        curl \
    && (apt-get install -y --no-install-recommends frama-c || apt-get install -y --no-install-recommends frama-c-base) \
    && rm -rf /var/lib/apt/lists/*

COPY --from=agent-node /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

WORKDIR /app

COPY requirements.txt package.json package-lock.json ./
RUN if [ -n "$PIP_INDEX_URL" ]; then python -m pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then python -m pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
    && python -m pip install -r requirements.txt
RUN if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi \
    && npm ci --omit=optional --no-audit --no-fund

COPY . .

# Keep executables outside /app/runtime: Compose mounts that path for user data.
ENV ACSL_AGENT_RUNTIME_ROOT=/opt/acsl-agent/agents
COPY --from=agent-runtime /opt/acsl-agent/agents /opt/acsl-agent/agents
RUN python scripts/install_agent_runtime.py --check \
    && npm run build:web

# Server-owned verifier, outside the mutable runtime data mount.
ARG INSTALL_VERIFAST=1
ENV VERIFAST_BINARY=/opt/acsl-agent/tools/verifast/verifast-26.10/bin/verifast
ENV VERIFAST_RUNTIME=host
ENV ACSL_VERIFIER_RUNTIME=host
RUN if [ "$INSTALL_VERIFAST" = "1" ]; then \
        python scripts/install_verifast.py --root /opt/acsl-agent/tools/verifast; \
    fi

# The fixed Verus release is installed for this image's architecture, not copied
# from a developer's macOS runtime. Linux arm64 needs a separately supplied build.
ARG INSTALL_VERUS=1
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH="/opt/cargo/bin:${PATH}"
RUN if [ "$INSTALL_VERUS" = "1" ]; then \
        curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
        && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain none \
        && python scripts/install_verus.py \
        && rm /tmp/rustup-init.sh; \
    fi

ENV ACSL_AGENT_LOCAL_TOOLCHAIN=1
ENV PATH="/app/third_party/autospec_llvm/bin:/opt/clang/bin:/root/.opam/default/bin:${PATH}"
ENV VERI_LIB_PATH="/app/third_party/autospec_llvm"
ENV LD_LIBRARY_PATH="/app/third_party/clang_llvm/lib:${LD_LIBRARY_PATH}"

EXPOSE 8000

CMD ["python", "scripts/run_api.py"]
