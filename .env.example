OPENAI_API_KEY=
aliyun_API_KEY=
volcano_API_KEY=
deepseek_API_KEY=
# Docker 容器访问微调模型的地址；直接端口映射可填写 http://10.102.128.126:8001/v1
QWEN35_4B_DOCKER_BASE_URL=http://host.docker.internal:18001/v1
QWEN35_9B_DOCKER_BASE_URL=http://host.docker.internal:18002/v1
QWEN35_9B_MIX64_DOCKER_BASE_URL=http://host.docker.internal:18003/v1

# 可选：使用单独的 NL2Verus 私有模型配置，否则复用平台模型配置
NL2VERUS_CONFIG=
# 可选：指定固定版本 Verus 可执行文件，否则使用 tools/verus 下本机版本
VERUS_EXECUTABLE=
